# Copy this file to .env and customize

# JWT secret for authentication (change in production!)
MELODRA_SECRET=melodra-dev-secret-change-in-prod

# Enable Flask debug mode (1 = on, 0 = off)
FLASK_DEBUG=1

# Optional: explicit path to Audiveris (only needed for local non-Docker setup)
# AUDIVERIS_JAR=/path/to/audiveris.jar
# AUDIVERIS_BAT=C:\Program Files\Audiveris\Audiveris.exe

# Optional: custom database path
# MELODRA_DB_PATH=/path/to/melodra.db
